# Flask application secrets. Use different random values, each at least 32 characters.
SECRET_KEY=replace-with-a-strong-random-flask-secret
JWT_SECRET=replace-with-a-different-strong-random-jwt-secret

# Direct/local backend connection settings. Docker Compose overrides these database
# connection variables with the restricted POSTGRES_APP_* account from the root .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=expense_app
POSTGRES_PASSWORD=replace-with-a-unique-strong-app-password
POSTGRES_DB=expense_management
