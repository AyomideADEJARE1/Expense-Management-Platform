# Docker Compose / PostgreSQL bootstrap settings.
# Copy to .env, keep it out of Git, and replace BOTH password placeholders.
# POSTGRES_USER is the database bootstrap/admin account used by migrations only.
POSTGRES_USER=expense_admin
POSTGRES_PASSWORD=replace-with-a-unique-strong-bootstrap-password
POSTGRES_DB=expense_management

# Restricted account used by the Flask application at runtime.
# The migration rejects passwords shorter than 32 characters or placeholder values.
POSTGRES_APP_USER=expense_app
POSTGRES_APP_PASSWORD=replace-with-a-different-unique-strong-app-password
